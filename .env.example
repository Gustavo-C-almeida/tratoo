# Variáveis do docker-compose LOCAL.  cp .env.example .env  e preencha.
# O .env está no .gitignore. NUNCA use aqui credenciais de produção (Neon, Asaas).
#
# ATENÇÃO com "$": o compose interpola valores sem aspas ou com aspas duplas.
# Chaves do Asaas começam com "$aact_" — use ASPAS SIMPLES, senão o valor vira vazio:
#   ASAAS_SANDBOX_API_KEY='$aact_...'
#
# Marcadas com (obrigatória): se faltarem, `docker compose up` para com erro.

# ── Banco (Postgres local com pgvector) ────────────────────────────────────────
POSTGRES_USER=tratoo
POSTGRES_PASSWORD=                     # (obrigatória) senha local, SEM ";" (vai dentro da connection string)

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=                        # (obrigatória) qualquer senha local
# (obrigatória) cifra o que a API grava no Redis (OTP, cadastro pendente) e esconde
# e-mail/IP nos nomes das chaves. Gere com:  openssl rand -base64 32
REDIS_CHAVE_PROTECAO=

# Réplicas da API atrás do Nginx (estado compartilhado no Redis).
API_REPLICAS=2

# ── Autenticação ───────────────────────────────────────────────────────────────
JWT_SECRET_KEY=                        # (obrigatória) 32+ caracteres aleatórios

# ── E-mail (Resend) — cadastro, MFA e reset de senha dependem disto ────────────
RESEND_API_KEY=                        # (obrigatória)
RESEND_FROM_EMAIL=                     # (obrigatória) remetente verificado no Resend
RESEND_FROM_NAME=Tratoo (local)

# ── Pagamentos (Asaas) — a URL do SANDBOX é fixa no compose ────────────────────
ASAAS_SANDBOX_API_KEY=''               # opcional; chave de SANDBOX, entre aspas simples
ASAAS_WEBHOOK_TOKEN=                   # (obrigatória) qualquer string aleatória
ASAAS_CONFIRMAR_TRANSFERENCIA_IMEDIATAMENTE=false

# ── Opcionais (a API sobe sem eles) ────────────────────────────────────────────
OPENAI_API_KEY=                        # sem ela a busca semântica cai para keyword
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
R2_PRIVATE_ACCOUNT_ID=
R2_PRIVATE_ACCESS_KEY=
R2_PRIVATE_BUCKET_NAME=
R2_PRIVATE_SERVICE_URL=

# ── Ambiente e portas ──────────────────────────────────────────────────────────
# Production = paridade com a Railway. Development liga Swagger e rotas de seed,
# inclusive /api/dev/seed-admin, que promove qualquer usuário a Admin SEM login.
ASPNETCORE_ENVIRONMENT=Production

# Troque se 80/443 estiverem ocupadas (ex.: IIS). O redirect 80→443 acompanha.
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# Subnet da rede interna — também é a faixa de proxy confiável da API.
COMPOSE_SUBNET=172.28.0.0/24
